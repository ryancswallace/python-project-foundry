[project]
name = "{{ project_slug }}"
version = "{{ initial_version }}"
description = "{{ project_description }}"
readme = "README.md"
requires-python = ">={{ python_min_version }},<{{ python_max_version_exclusive }}"
license = "{{ license }}"
authors = [
    { name = "{{ author_name }}", email = "{{ author_email }}" },
]
maintainers = [
    { name = "{{ author_name }}", email = "{{ author_email }}" },
]
keywords = [
    "python",
]
classifiers = [
    "Development Status :: 3 - Alpha",
    "Intended Audience :: Developers",
{% if license == "MIT" %}
    "License :: OSI Approved :: MIT License",
{% elif license == "BSD-3-Clause" %}
    "License :: OSI Approved :: BSD License",
{% endif %}
    "Operating System :: OS Independent",
    "Programming Language :: Python :: 3",
{% for minor in range(
  python_min_version.split(".")[1] | int,
  (python_default_version.split(".")[1] | int) + 1
) %}
    "Programming Language :: Python :: 3.{{ minor }}",
{% endfor %}
    "Programming Language :: Python :: Implementation :: CPython",
    "Topic :: Software Development :: Libraries :: Python Modules",
    "Typing :: Typed",
]
dependencies = []

[project.urls]
Homepage = "{{ repository_url }}"
Changelog = "{{ repository_url }}/blob/main/CHANGELOG.md"
Documentation = "{{ documentation_url }}"
Issues = "{{ repository_url }}/issues"
Source = "{{ repository_url }}"

[dependency-groups]
test = [
    "hypothesis>=6.155.7",
    "pytest>=9.1.1",
    "pytest-cov>=7.1.0",
]
lint = [
    "pre-commit>=4.6.0",
    "ruff>=0.15.18",
]
type = [
    "basedpyright>=1.39.8",
]
docs = [
    "linkchecker>=10.6.0",
    "mkdocs-gen-files>=0.5.0",
    "mkdocs-material>=9,<10",
    "mkdocs>=1.6.1",
    "mkdocstrings[python]>=1.0.4",
]
security = [
    "bandit[toml]>=1.9.4",
    "deptry>=0.25.1",
    "detect-secrets>=1.5.0",
    "pip-audit>=2.10.1",
    "zizmor>=1.26.1",
]
release = [
    "build>=1.5.0",
    "cyclonedx-bom>=7.3.0",
    "twine>=6.2.0",
]
automation = [
    "nox>=2026.4.10",
]
dev = [
    { include-group = "automation" },
    { include-group = "docs" },
    { include-group = "lint" },
    { include-group = "release" },
    { include-group = "security" },
    { include-group = "test" },
    { include-group = "type" },
]

[tool.uv]
link-mode = "copy"
required-version = ">=0.11.8,<0.12"

[build-system]
requires = ["hatchling>=1.30.1"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.sdist]
include = [
    "/CHANGELOG.md",
    "/CITATION.cff",
    "/CODE_OF_CONDUCT.md",
    "/CONTRIBUTING.md",
    "/docs",
    "/LICENSE",
    "/mkdocs.yml",
    "/noxfile.py",
    "/README.md",
    "/RELEASE.md",
    "/SECURITY.md",
    "/examples",
    "/src",
    "/tests",
]

[tool.hatch.build.targets.wheel]
packages = ["src/{{ package_name }}"]

[tool.pytest.ini_options]
minversion = "8.4"
testpaths = ["tests"]
pythonpath = ["src"]
empty_parameter_set_mark = "fail_at_collect"
xfail_strict = true
required_plugins = [
    "pytest-cov>=7.1.0",
]
addopts = [
    "-ra",
    "--strict-config",
    "--strict-markers",
    "--cov={{ package_name }}",
    "--cov-report=term-missing",
]
filterwarnings = [
    "error",
]
markers = [
    "integration: tests that exercise installed packages or third-party runtime integrations",
    "property: property-based tests powered by Hypothesis",
    "slow: tests that do packaging, subprocess, or otherwise slower work",
    "unit: fast isolated tests for local package behavior",
]
norecursedirs = [
    "*.egg",
    "*.egg-info",
    ".git",
    ".hypothesis",
    ".mypy_cache",
    ".nox",
    ".pyright",
    ".pytest_cache",
    ".ruff_cache",
    ".tox",
    ".venv",
    "build",
    "dist",
    "env",
    "htmlcov",
    "node_modules",
    "reports",
    "site",
    "venv",
]

[tool.coverage.run]
branch = true
relative_files = true
source = ["{{ package_name }}"]

[tool.coverage.paths]
source = [
    "src/{{ package_name }}",
    "*/site-packages/{{ package_name }}",
]

[tool.coverage.report]
fail_under = {{ coverage_fail_under }}
precision = 2
show_missing = true
skip_empty = true
skip_covered = true

[tool.ruff]
line-length = 120
src = ["src", "tests", "examples", "scripts", "docs/_scripts"]
target-version = "py311"

[tool.ruff.lint]
select = ["B", "C4", "E", "F", "I", "PIE", "PT", "RET", "RUF", "SIM", "UP"]

[tool.ruff.lint.isort]
known-first-party = ["{{ package_name }}"]

[tool.ruff.format]
line-ending = "lf"

[tool.basedpyright]
include = ["src", "tests", "examples", "scripts", "docs/_scripts", "noxfile.py"]
exclude = [".venv", "build", "dist", "node_modules"]
pythonVersion = "{{ python_min_version }}"
typeCheckingMode = "standard"
venvPath = "."
venv = ".venv"

[tool.bandit]
exclude_dirs = ["tests"]

[tool.deptry]
ignore_notebooks = true
known_first_party = ["{{ package_name }}"]
